{
  "id": "./",
  "name": "Alicerce — Wireframes de baixa fidelidade",
  "short_name": "Alicerce",
  "description": "Ferramenta de prototipação rápida de wireframes de baixa fidelidade para telas web e mobile. Funciona 100% offline.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#FFFFFF",
  "theme_color": "#29243C",
  "categories": ["productivity", "utilities", "design"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Novo Projeto",
      "short_name": "Novo",
      "description": "Criar um novo projeto de wireframe",
      "url": "./index.html?action=new",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Meus Projetos",
      "short_name": "Projetos",
      "description": "Abrir o gerenciador de projetos salvos",
      "url": "./index.html?action=projects",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Projeto Alicerce",
      "accept": {
        "application/json": [".alicerce", ".json"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  }
}
